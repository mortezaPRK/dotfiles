#!/bin/bash

config_file="$HOME/.config/ai.yaml"

function die() {
    echo "$@" >&2
    exit 1
}

function check() {
    if [[ ! -f "$config_file" ]]
    then
        die "Error: Config file not found at $config_file"
    fi

    if ! command -v fzf &> /dev/null
    then
        die "Error: fzf is not installed."
    fi

    if ! command -v yq &> /dev/null
    then
        die "Error: yq is not installed."
    fi

    local err
    if ! err=$(yq -e '.' "$config_file" 2>&1 >/dev/null)
    then
        die "Error: invalid config file $config_file: $err"
    fi

    local dups
    dups=$(yq -r '.profiles | keys | group_by(.) | filter(length > 1) | map(.[0]) | join(", ")' "$config_file")
    if [[ -n "$dups" ]]
    then
        die "Error: duplicate profile name(s) in $config_file: $dups"
    fi
}

function get_env() {
    local mode="${AI_MODE}"

    if [[ -n "$mode" ]] && ! AI_LOOKUP="$mode" yq -e '.profiles[strenv(AI_LOOKUP)]' "$config_file" &>/dev/null
    then
        local full_key
        full_key=$(AI_PREFIX="$mode" yq -r '.profiles | keys | .[] | select(test("^" + strenv(AI_PREFIX)))' "$config_file" | head -1)
        [[ -n "$full_key" ]] && mode="$full_key"
    fi

    while ! AI_LOOKUP="$mode" yq -e '.profiles[strenv(AI_LOOKUP)]' "$config_file" &>/dev/null
    do
        local sel
        sel=$(yq -r '.profiles | to_entries | .[] | .key + ": " + .value.desc' "$config_file" \
              | fzf --prompt="Select Claude environment: " --height=40% --reverse)
        if [ $? -eq 130 ]; then exit 1; fi

        if [[ -z "$sel" ]]
        then
            echo "No environment selected, please try again" >&2
            mode=""
        else
            mode="${sel%%: *}"
        fi
    done

    local entry line key val
    local -a keys=()
    entry=$(AI_LOOKUP="$mode" yq --yaml-fix-merge-anchor-to-spec -r '.profiles[strenv(AI_LOOKUP)].env | explode(.) | to_entries | .[] | .key + "=" + .value' "$config_file")

    while IFS= read -r line
    do
        [[ -z "$line" ]] && continue
        key="${line%%=*}"
        val="${line#*=}"
        printf 'export %s=%q\n' "$key" "$val"
        keys+=("$key")
    done <<< "$entry"

    printf 'export AI_KEYS=%q\n' "${keys[*]}"
}

function sanitize_claude_settings() {
    local settings="$HOME/.claude/settings.json"
    yq -i -o=json 'del(.model)' "$settings"
}

check
envs=$(get_env)
eval "$envs"

case "$1" in
    ""|-h|--help)
        echo "Usage: ai [command] [args]"
        echo "Usage: ai --help"
        echo "Usage: ai --print-env"
        exit 0
        ;;
    --print-env)
        echo "$envs"
        exit 0
        ;;
    ssh)
        if [ -n "$AI_KEYS" ]; then
            shift
            set -- ssh -o SendEnv="${AI_KEYS}" "$@"
        fi
        ;;
    claude)
        sanitize_claude_settings
        ;;
esac

exec "$@"
