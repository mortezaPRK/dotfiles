[user]
	name = Morteza PRK
	email = mortezaPRK@users.noreply.github.com

[difftool]
	prompt = false

[core]
	editor = vim
	excludesfile = ~/.gitignore_global

[pull]
	rebase = false

[push]
	autoSetupRemote = true

[init]
	defaultBranch = main

[include]
    path = .local.gitconfig

# Path specific .gitconfig
# [includeIf "gitdir:~/Work/<org>/"]
# 	path = ~/Work/<org>/.gitconfig
[alias]
	f = fetch -apPft
	p = !git push --set-upstream origin \"$(git symbolic-ref --short -q HEAD)\"
	s = !git fetch --all --prune --tags && git pull --ff-only

[filter "lfs"]
	process = git-lfs filter-process
	required = true
	clean = git-lfs clean -- %f
	smudge = git-lfs smudge -- %f
